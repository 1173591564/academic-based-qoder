PROXY_HUB_DATABASE_PASSWORD=replace-with-a-local-password
PROXY_HUB_PUBLIC_ORIGIN=http://localhost:8080
PROXY_HUB_ALLOW_INSECURE_PUBLIC_HTTP=false
PROXY_HUB_COOKIE_NAME=proxy_hub_session
PROXY_HUB_PORT=8080
PROXY_HUB_OIDC_ISSUER_URL=https://identity.example.com
PROXY_HUB_OIDC_CLIENT_ID=proxy-hub-local
PROXY_HUB_OIDC_CLIENT_SECRET=replace-with-an-oidc-client-secret
PROXY_HUB_BOOTSTRAP_PLATFORM_ADMIN_SUBJECTS=replace-with-your-oidc-subject
PROXY_HUB_SINGLE_LAB_TENANT_SLUG=scholar-lab
PROXY_HUB_SINGLE_LAB_TENANT_NAME=Scholar Lab
PROXY_HUB_SINGLE_LAB_BACKEND_NAME=Scholar Backend
PROXY_HUB_SINGLE_LAB_BACKEND_URL=https://scholar.example.com/mcp
PROXY_HUB_SINGLE_LAB_CORPUS_VERSION=replace-with-the-corpus-version
PROXY_HUB_SINGLE_LAB_BACKEND_CREDENTIAL_REF=env:SCHOLAR_SERVICE_TOKEN
PROXY_HUB_ADMIN_RATE_LIMIT_REQUESTS=120
PROXY_HUB_ADMIN_RATE_LIMIT_PERIOD_SECONDS=60
PROXY_HUB_BACKEND_SAFE_RETRY_ATTEMPTS=1
PROXY_HUB_BACKEND_RETRY_BACKOFF_SECONDS=0.1
PROXY_HUB_BACKEND_CIRCUIT_FAILURE_THRESHOLD=3
PROXY_HUB_BACKEND_CIRCUIT_RECOVERY_SECONDS=30
PROXY_HUB_AUDIT_FAILURE_POLICY=fail_closed
SCHOLAR_SERVICE_TOKEN=replace-with-a-scholar-service-token
