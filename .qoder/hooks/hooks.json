{
  "description": "Scholar Studio 自动化钩子",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"${QODER_PLUGIN_ROOT}/hooks/task-done.ps1\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"${QODER_PLUGIN_ROOT}/hooks/log-conversation.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"${QODER_PLUGIN_ROOT}/hooks/block-dangerous.ps1\""
          }
        ]
      }
    ]
  }
}
